# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Public anon key used only for Supabase Auth session exchange. This key is safe
# for browser-visible naming, but this app still performs database work server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Slug of the campaign the root URL (/) redirects to.
# Example: DEFAULT_CAMPAIGN=nemirof makes / redirect to /nemirof
DEFAULT_CAMPAIGN=nemirof

# Public site URL used in reminder emails (unsubscribe / manage links).
# On Vercel this can be omitted if VERCEL_PROJECT_PRODUCTION_URL is set.
APP_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer CRON_SECRET to /api/cron/reminders
CRON_SECRET=choose-a-long-random-string

# Global email-reminder release gate. Keep false until the feature is verified and launched.
# When false, the UI is hidden, enrollment is rejected, and the reminder job is a no-op.
ENABLE_EMAIL_REMINDERS=false

# Email reminders (Resend — free tier is 3,000/month, 100/day).
# Enabling also requires a verified sender and both values below.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM="Mishnayos <reminders@your-verified-domain.com>"

# Future time-sensitive channels. Keep disabled until the precise scheduler phase ships.
ENABLE_VOICE_REMINDERS=false

# Automated reminder phone calls (Twilio Voice). Not exposed unless the flag above
# is true and all credentials are configured.
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
